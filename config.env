# Shared settings for all scripts. Edit to match your server.

# "systemd" = server from the linuxvox guide (systemd + screen)
# "docker"  = server started with docker-compose.yml in this folder
SERVER_MODE=systemd

# --- systemd mode ---
SERVER_DIR=/home/minecraft/minecraft_server
MC_USER=minecraft
SERVICE_NAME=minecraft.service
SCREEN_NAME=mcjava
SERVER_JAR=paper-server.jar

# --- docker mode ---
# Server files live in ./data next to docker-compose.yml (SERVER_DIR is overridden).
DOCKER_SERVICE=mc

# Minecraft version to track. Empty = keep whatever version is installed now.
# Paper only updates builds within this version; change it on purpose to upgrade MC.
MC_VERSION=

# --- backups ---
BACKUP_DIR=/home/minecraft/backups
KEEP_LOCAL=7                                # local archives to keep
PROTON_ENABLED=true
PROTON_BIN=/usr/local/bin/proton-drive
PROTON_PARENT=/my-files                     # Proton Drive root
PROTON_FOLDER=minecraft-backups             # created under PROTON_PARENT
# Headless servers: store the Proton session with `pass` instead of a desktop keyring.
PROTON_DRIVE_CREDENTIALS_STORE=pass

# Sent to the PaperMC / Hangar APIs (they require a contact).
USER_AGENT="shadowrealm-scripts/1.0 (wullaski@gmail.com)"
